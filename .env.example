# DOMINION: copy to .env only if using a compatible env loader; otherwise export in your shell.
DOMINION_HOST=127.0.0.1
DOMINION_PORT=4317
DOMINION_DATA=./runtime
DOMINION_WORKSPACE=./workspace
# Required before binding beyond loopback:
# DOMINION_ADMIN_TOKEN=long-random-token
# Optional web search credentials (web_search falls back to public DuckDuckGo/Bing)
# SEARXNG_URL=http://127.0.0.1:8080
# BRAVE_API_KEY=
# Optional OAuth apps. Register this callback in GitHub/Google:
# http://127.0.0.1:53682/api/oauth/<provider>/callback
# DOMINION_OAUTH_ORIGIN=http://127.0.0.1:53682
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
